{
	"name": "surescore-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-20",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "__CLOUDFLARE_D1_DATABASE_NAME__",
			"database_id": "__CLOUDFLARE_D1_DATABASE_ID__",
			"preview_database_id": "__CLOUDFLARE_D1_PREVIEW_DATABASE_ID__",
			"migrations_dir": "../../packages/db/prisma/migrations",
		},
	],
}
