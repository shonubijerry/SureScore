{
	"name": "surescore-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-20",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Non-secret config. Secrets (AUTH_SECRET, PAYSTACK_SECRET_KEY, KUDISMS_API_KEY, ...)
	// live in .dev.vars locally and `wrangler secret put` in production.
	"vars": {
		"PAYSTACK_CUSTOMER_EMAIL": "info@corestack.com.ng",
		// Must be a Corporate Sender ID approved on the KudiSMS account (my.kudisms.net/user/scid).
		"KUDISMS_SENDER_ID": "SureScore",
		// Sender for sign-in codes. The domain must be onboarded in Cloudflare
		// (Compute > Email Service > Email Sending > Onboard Domain).
		"EMAIL_FROM_ADDRESS": "no-reply@corestack.com.ng",
		"EMAIL_FROM_NAME": "SureScore"
	},
	// Cloudflare Email Service. Deployed, this sends real email. Under
	// `wrangler dev` it is simulated: emails (and their codes) are printed to
	// the console and saved to files. Add "remote": true to send real email locally.
	"send_email": [{ "name": "EMAIL" }],
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "surescore_db",
			"database_id": "d25544c9-1141-47af-b2c6-0e802240c80e",
			"migrations_dir": "../../packages/db/prisma/migrations",
			"migrations_pattern": "../../packages/db/prisma/migrations/*/migration.sql"
		}
	],
	"kv_namespaces": [
		// Run `wrangler kv namespace create SESSIONS` and replace this id.
		{
			"binding": "SESSIONS",
			"id": "__CLOUDFLARE_KV_SESSIONS_ID__"
		}
	],
	"queues": {
		"producers": [
			{ "binding": "TRANSFER_QUEUE", "queue": "surescore-transfers" }
		],
		"consumers": [
			{
				"queue": "surescore-transfers",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 5,
				"dead_letter_queue": "surescore-transfers-dlq"
			}
		]
	},
	"triggers": {
		"crons": [
			"0 */4 * * *",
			"*/30 * * * *",
			"0 2 * * *"
		]
	}
}
