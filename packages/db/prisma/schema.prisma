generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// One score prediction per user per pot (enforced by the unique index).
// `firstGoalMinute` feeds the optional first-goal tie-break. Previous values
// are kept in PredictionEdit whenever a pre-lock edit changes them.
model Prediction {
  id              String   @id @default(cuid())
  potId           String
  userId          String
  homeGoals       Int
  awayGoals       Int
  firstGoalMinute Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  pot   Pot                @relation(fields: [potId], references: [id])
  user  User               @relation(fields: [userId], references: [id])
  edits PredictionEdit[]

  @@unique([potId, userId])
  @@index([userId])
}

// Append-only edit history: the values a prediction had before each edit.
model PredictionEdit {
  id              String   @id @default(cuid())
  predictionId    String
  homeGoals       Int
  awayGoals       Int
  firstGoalMinute Int?
  replacedAt      DateTime @default(now())

  prediction Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)

  @@index([predictionId, replacedAt])
}

// Account identity. Country is fixed at signup and drives currency, provider,
// and eligibility rules elsewhere (see @surescore/shared country-config).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  passwordSalt String
  countryCode  String
  displayName  String?
  role         String   @default("user")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payoutAccounts PayoutAccount[]
  ledgerEntries  LedgerEntry[]
  pots           Pot[]
  predictions    Prediction[]

  @@index([countryCode])
}

// Where a user's winnings are paid out. Provider is derived from countryCode
// at creation time (see resolvePaymentProviderForCountry).
model PayoutAccount {
  id            String   @id @default(cuid())
  userId        String
  countryCode   String
  provider      String
  accountName   String
  accountNumber String // AES-GCM ciphertext (see apps/api secure-data); never the raw number
  accountNumberHash String? // keyed hash, for duplicate-account detection without decrypting
  accountLast4  String?
  providerRecipientCode String? // provider-issued payout recipient (e.g. Paystack RCP_...); reset when bank details change
  recipientProvider     String? // provider id that issued providerRecipientCode
  bankCode      String?
  isDefault     Boolean  @default(false)
  isVerified    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accountNumberHash])
}

// Normalized, cached sports events (see @surescore/shared SportsEvent). This
// table is the only view of match data the rest of the app should read from;
// provider-specific responses (ESPN, etc.) never reach it directly.
model SportsEventCache {
  id                    String   @id // "{provider}:{externalId}"
  provider              String
  externalId            String
  league                String
  homeTeam              String
  awayTeam              String
  kickoffTimeUtc        DateTime
  status                String // scheduled | live | finished | postponed | abandoned
  homeScore             Int?
  awayScore             Int?
  isFinalResultOfficial Boolean  @default(false)
  firstGoalMinute       Int? // regulation-time first goal; tie-break input
  underdog              String? // home | away, from pre-match moneyline; tie-break input
  freshness             String   @default("cached") // live | cached | stale
  lastRefreshedAt       DateTime
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  pots Pot[]

  @@unique([provider, externalId])
  @@index([league])
  @@index([status])
  @@index([kickoffTimeUtc])
}

// Append-only financial ledger. Rows are never updated or deleted: every
// state change of a fund/refund/payout is a new row. `entryKey` makes writes
// idempotent (a redelivered queue message cannot create a duplicate row).
model LedgerEntry {
  id               String   @id @default(cuid())
  entryKey         String   @unique // "{idempotencyKey}:{attempt}"
  idempotencyKey   String // groups all attempts of one financial action
  type             String // fund | refund | payout
  status           String // pending | successful | failed
  userId           String
  potId            String
  countryCode      String
  currency         String
  amountMinorUnits Int
  provider         String
  reference        String?
  detail           String?
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([idempotencyKey])
  @@index([userId, createdAt])
  @@index([potId])
  @@index([type, status, createdAt])
  @@index([reference])
}

// A funded prediction pot tied to one match. Currency and payment provider are
// copied from the potter's country config at creation and never change.
model Pot {
  id                    String   @id @default(cuid())
  potterId              String
  eventId               String
  countryCode           String
  currency              String
  provider              String
  prizeAmountMinorUnits Int
  winnerCount           Int
  status                String   @default("Draft")
  fundingReference      String?
  shareCode             String?  @unique // set only once funding succeeds
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  potter      User                 @relation(fields: [potterId], references: [id])
  event       SportsEventCache     @relation(fields: [eventId], references: [id])
  transitions PotStateTransition[]
  predictions Prediction[]

  @@index([potterId])
  @@index([eventId])
  @@index([status])
}

// Append-only audit trail: one row per pot state transition.
model PotStateTransition {
  id         String   @id @default(cuid())
  potId      String
  fromStatus String?
  toStatus   String
  actorType  String // user | system | admin
  actorId    String?
  reason     String
  createdAt  DateTime @default(now())

  pot Pot @relation(fields: [potId], references: [id])

  @@index([potId, createdAt])
}

// Append-only trail of every admin action (retries, disputes, overrides,
// notes, reconciliation reviews, staff changes, payout-detail changes).
// `reason` is mandatory for all of them.
model AdminAuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String // see AUDIT_ACTIONS in apps/api/src/lib/audit.ts
  potId     String?
  subject   String? // idempotency key, finding id, ...
  reason    String
  createdAt DateTime @default(now())

  @@index([potId, createdAt])
  @@index([createdAt])
  @@index([actorId, createdAt])
}

// Admin-supplied regulation result used instead of the cached match when the
// provider data is wrong or stuck. One per pot; final once written.
model SettlementOverride {
  id              String   @id @default(cuid())
  potId           String   @unique
  homeGoals       Int
  awayGoals       Int
  firstGoalMinute Int?
  reason          String
  adminId         String
  createdAt       DateTime @default(now())
}

// One row per background job execution, for the admin job-failure view.
model JobRun {
  id         String   @id @default(cuid())
  job        String // fixture-prefetch | live-refresh | settlement | reconciliation
  kind       String // sports | payments | finance
  status     String // ok | failed
  error      String?
  durationMs Int
  startedAt  DateTime @default(now())

  @@index([job, startedAt])
  @@index([status, startedAt])
}

// A reconciliation pass over the ledger. `summary` is JSON totals per currency.
model ReconciliationRun {
  id           String   @id @default(cuid())
  scopeFrom    DateTime
  potsChecked  Int
  findingCount Int
  summary      String
  startedAt    DateTime @default(now())

  @@index([startedAt])
}

// An anomaly found by reconciliation. `fingerprint` makes re-runs idempotent:
// the same anomaly is recorded (and reviewed) once.
model ReconciliationFinding {
  id             String    @id @default(cuid())
  runId          String
  fingerprint    String    @unique
  code           String
  severity       String // critical | high | medium
  potId          String?
  userId         String?
  detail         String
  status         String    @default("open") // open | resolved
  resolvedBy     String?
  resolutionNote String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([status, severity])
  @@index([potId])
}
