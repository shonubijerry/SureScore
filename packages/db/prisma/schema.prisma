generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// One score prediction per user per pot (enforced by the unique index).
// `firstGoalMinute` feeds the optional first-goal tie-break. Previous values
// are kept in PredictionEdit whenever a pre-lock edit changes them.
model Prediction {
  id              String   @id @default(cuid())
  potId           String
  userId          String
  homeGoals       Int
  awayGoals       Int
  firstGoalMinute Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  pot   Pot                @relation(fields: [potId], references: [id])
  user  User               @relation(fields: [userId], references: [id])
  edits PredictionEdit[]

  @@unique([potId, userId])
  @@index([userId])
  @@index([potId, id]) // keyset pages of a pot's predictions read only the page's rows
}

// Append-only edit history: the values a prediction had before each edit.
model PredictionEdit {
  id              String   @id @default(cuid())
  predictionId    String
  homeGoals       Int
  awayGoals       Int
  firstGoalMinute Int?
  replacedAt      DateTime @default(now())

  prediction Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)

  @@index([predictionId, replacedAt])
}

// Account identity. Users sign up and sign in with their email address
// (verified by an emailed code at signup); it is required by the app for every
// new account. The column stays nullable only because accounts created during
// phone sign-in may lack one, and tightening it would rebuild "User" on D1.
// Phone is collected at signup but not verified, so it is not unique (a
// unique unverified number would let anyone block its real owner).
// Country is fixed at signup and drives currency, provider, and eligibility
// rules elsewhere (see @surescore/shared country-config).
model User {
  id           String   @id @default(cuid())
  email        String?  @unique // lowercased; the sign-in id
  emailVerifiedAt DateTime?
  phone        String? // E.164, e.g. "+2348012345678"; not verified
  phoneVerifiedAt DateTime? // set only for accounts verified by SMS during phone sign-in
  passwordHash String
  passwordSalt String
  countryCode  String
  displayName  String?
  role         String   @default("user")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payoutAccounts PayoutAccount[]
  ledgerEntries  LedgerEntry[]
  pots           Pot[]
  predictions    Prediction[]

  @@index([countryCode])
  @@index([phone])
  @@index([createdAt, id]) // admin user directory, newest first (keyset)
  @@index([role, createdAt, id]) // staff list
}

// Where a user's winnings are paid out. Provider is derived from countryCode
// at creation time (see resolvePaymentProviderForCountry).
model PayoutAccount {
  id            String   @id @default(cuid())
  userId        String
  countryCode   String
  provider      String
  accountName   String
  accountNumber String // AES-GCM ciphertext (see apps/api secure-data); never the raw number
  accountNumberHash String? // keyed hash, for duplicate-account detection without decrypting
  accountLast4  String?
  providerRecipientCode String? // provider-issued payout recipient (e.g. Paystack RCP_...); reset when bank details change
  recipientProvider     String? // provider id that issued providerRecipientCode
  bankCode      String?
  isDefault     Boolean  @default(false)
  isVerified    Boolean  @default(false)
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accountNumberHash])
  @@index([userId, deletedAt])
}

// Normalized, cached sports events (see @surescore/shared SportsEvent). This
// table is the only view of match data the rest of the app should read from;
// provider-specific responses (ESPN, etc.) never reach it directly.
model SportsEventCache {
  id                    String   @id // "{provider}:{externalId}"
  provider              String
  externalId            String
  league                String
  homeTeam              String
  awayTeam              String
  homeTeamId            String? // provider team id; resolves to a logo via the provider config
  awayTeamId            String?
  kickoffTimeUtc        DateTime
  status                String // scheduled | live | finished | postponed | abandoned
  homeScore             Int?
  awayScore             Int?
  isFinalResultOfficial Boolean  @default(false)
  firstGoalMinute       Int? // regulation-time first goal; tie-break input
  underdog              String? // home | away, from pre-match moneyline; tie-break input
  importance            Int      @default(0) // provider-signalled prominence (ESPN: broadcast coverage count); ranks popular matches
  freshness             String   @default("cached") // live | cached | stale
  lastRefreshedAt       DateTime
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  pots Pot[]

  @@unique([provider, externalId])
  @@index([league])
  @@index([status])
  @@index([kickoffTimeUtc])
  @@index([status, importance])
  @@index([status, kickoffTimeUtc, id]) // upcoming/live/results lists (keyset)
}

// Append-only financial ledger. Rows are never updated or deleted: every
// state change of a fund/refund/payout is a new row. `entryKey` makes writes
// idempotent (a redelivered queue message cannot create a duplicate row).
model LedgerEntry {
  id               String   @id @default(cuid())
  entryKey         String   @unique // "{idempotencyKey}:{attempt}"
  idempotencyKey   String // groups all attempts of one financial action
  type             String // fund | refund | payout
  status           String // pending | successful | failed
  userId           String
  potId            String
  countryCode      String
  currency         String
  amountMinorUnits Int
  provider         String
  reference        String?
  detail           String?
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([idempotencyKey])
  @@index([userId, createdAt])
  @@index([potId])
  @@index([type, status, createdAt])
  @@index([reference])
  @@index([type, createdAt, id]) // payout/refund queues without a status filter (keyset)
  @@index([createdAt, id]) // ledger search, newest first
}

// A funded prediction pot tied to one match. Currency and payment provider are
// copied from the potter's country config at creation and never change.
model Pot {
  id                    String   @id @default(cuid())
  potterId              String
  eventId               String
  countryCode           String
  currency              String
  provider              String
  prizeAmountMinorUnits Int
  winnerCount           Int
  status                String   @default("Draft")
  fundingReference      String?
  refundAccountId       String? // potter's PayoutAccount for refunds; no FK so adding it never rebuilds Pot
  isPrivate             Boolean  @default(false) // hidden from discovery; reachable only via the share link (or by its potter/players)
  shareCode             String?  @unique // set only once funding succeeds
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  potter      User                 @relation(fields: [potterId], references: [id])
  event       SportsEventCache     @relation(fields: [eventId], references: [id])
  transitions PotStateTransition[]
  predictions Prediction[]

  @@index([potterId])
  @@index([eventId])
  @@index([status])
  @@index([isPrivate, status])
  @@index([updatedAt, id]) // admin pot list, most recently changed first (keyset)
  @@index([status, updatedAt, id]) // admin pot list filtered by state
  @@index([potterId, createdAt, id]) // "my pots", newest first
}

// Append-only audit trail: one row per pot state transition.
model PotStateTransition {
  id         String   @id @default(cuid())
  potId      String
  fromStatus String?
  toStatus   String
  actorType  String // user | system | admin
  actorId    String?
  reason     String
  createdAt  DateTime @default(now())

  pot Pot @relation(fields: [potId], references: [id])

  @@index([potId, createdAt])
}

// Append-only trail of every admin action (retries, disputes, overrides,
// notes, reconciliation reviews, staff changes, payout-detail changes).
// `reason` is mandatory for all of them.
model AdminAuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String // see AUDIT_ACTIONS in apps/api/src/lib/audit.ts
  potId     String?
  subject   String? // idempotency key, finding id, ...
  reason    String
  createdAt DateTime @default(now())

  @@index([potId, createdAt])
  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt]) // audit log filtered by action
}

// Admin-supplied regulation result used instead of the cached match when the
// provider data is wrong or stuck. One per pot; final once written.
model SettlementOverride {
  id              String   @id @default(cuid())
  potId           String   @unique
  homeGoals       Int
  awayGoals       Int
  firstGoalMinute Int?
  reason          String
  adminId         String
  createdAt       DateTime @default(now())
}

// One row per background job execution, for the admin job-failure view.
model JobRun {
  id         String   @id @default(cuid())
  job        String // fixture-prefetch | match-cleanup | live-refresh | settlement | reconciliation
  kind       String // sports | payments | finance
  status     String // ok | failed
  error      String?
  durationMs Int
  startedAt  DateTime @default(now())

  @@index([job, startedAt])
  @@index([status, startedAt])
}

// A reconciliation pass over the ledger. `summary` is JSON totals per currency.
model ReconciliationRun {
  id           String   @id @default(cuid())
  scopeFrom    DateTime
  potsChecked  Int
  findingCount Int
  summary      String
  startedAt    DateTime @default(now())

  @@index([startedAt])
}

// An anomaly found by reconciliation. `fingerprint` makes re-runs idempotent:
// the same anomaly is recorded (and reviewed) once.
model ReconciliationFinding {
  id             String    @id @default(cuid())
  runId          String
  fingerprint    String    @unique
  code           String
  severity       String // critical | high | medium
  potId          String?
  userId         String?
  detail         String
  status         String    @default("open") // open | resolved
  resolvedBy     String?
  resolutionNote String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([status, severity])
  @@index([potId])
  @@index([status, createdAt, id]) // findings list (keyset)
}
